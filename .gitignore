# Jac compiled module cache
*.jir

# Jac persistent graph store
*.db

# experiment outputs (benchmark/workload/run_schedule.py)
results/

# survey raw corpora that are large or re-downloadable (see survey/README.md)
survey/data/raw/hf/
survey/data/raw/n8n_api/workflows*.jsonl
survey/data/raw/n8n_api/details*.log
survey/data/_src/
survey/data/parsed/*.jsonl

# python bytecode / jac per-project cache
__pycache__/
.jac/

**/wiki_cache/
**/__pycache__/
**/.jac/
**/.vscode/

# benchmark run outputs: server logs, driver .out, per-tag session logs,
# sessions.jsonl, summary.json; the sweep/summary CSVs and hand-written .md notes stay tracked
benchmark/mixed_results/**
!benchmark/mixed_results/**/
!benchmark/mixed_results/**/*.csv
!benchmark/mixed_results/**/*.md

# runtime caches: tool results and static-analysis payloads
**/web_cache/
benchmark/applications/bench_data/BFCL/warm_cache.log
static_analysis/.cache/

# local virtualenvs (e.g. paper/sections/motivation_data/common_structure/.venv)
**/.venv/
