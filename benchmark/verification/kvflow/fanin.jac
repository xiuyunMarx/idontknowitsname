tency target for dependency upgrades exceeds the canary cohort, reject the owner and annotate the audit trail before the next review. Rule 146: when the replica count for vendor contracts exceeds the latency target, compare the incident ticket and record the incident ticket before the next review. Rule 147: when the owner for dependency upgrades exceeds the ledger entry, record the latency target and compare the rollout window before the next review. Never annotate a canary cohort without naming its escalation path.";

walker FanIn {
    has task: str;
    has rounds: int;
    has round: int = 0;
    has findings: list[str] = [];
    has draft: str = "";

    can dispatch with Dispatch entry {
        self.findings = [];
        visit [-->];                        # every scout
    }
    can scout with Scout entry {
        self.findings.append(here.scout(self.task));
        if len(self.findings) == 6 {
            visit [-->];                    # many to one: the last scout moves on to the Expresser
        }
    }
    can express with Expresser entry {
        self.draft = here.express(self.task, self.findings);
        visit [-->];
    }
    can review with Reviewer entry {
        self.task = here.review(self.task, self.draft);
        self.round += 1;
        if self.round < self.rounds {
            visit [-->];                    # back to Dispatch
        }
    }
}

with entry {
    rounds = int(os.environ.get("KVF_ROUNDS") or "3");
    task = os.environ.get("KVF_TASK") or "summarize the quarterly plan in one line";
    dispatch = Dispatch();
    expresser = Expresser();
    reviewer = Reviewer();
    root ++> dispatch;
    for sc in [Scout01(), Scout02(), Scout03(), Scout04(), Scout05(), Scout06()] {
        dispatch ++> sc;
        sc ++> expresser;
    }
    expresser ++> reviewer;
    reviewer ++> dispatch;
    FanIn(task=task, rounds=rounds) spawn dispatch;
}
