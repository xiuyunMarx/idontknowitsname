walker Pipeline {
    has task: str;
    has rounds: int;
    has steps: int = 0;

    can step with Agent entry {
        self.task = here.run(self.task);     # each stage's reply is the next stage's input
        self.steps += 1;
        if self.steps < self.rounds * N_AGENTS {
            visit [-->];                    # the ring: Agent08 --> Agent01
        }
    }
}

with entry {
    rounds = int(os.environ.get("KVF_ROUNDS") or "3");
    task = os.environ.get("KVF_TASK") or "summarize the quarterly plan in one line";
    agents = [Agent01(), Agent02(), Agent03(), Agent04(), Agent05(), Agent06(), Agent07(), Agent08()];
    root ++> agents[0];
    for i in range(len(agents)) {
        agents[i] ++> agents[(i + 1) % len(agents)];
    }
    Pipeline(task=task, rounds=rounds) spawn agents[0];
}
