walker FanOut {
    has task: str;
    has rounds: int;
    has fanout: int;
    has round: int = 0;
    has plan: str = "";
    has findings: list[str] = [];

    can plan with Planner entry {
        self.plan = here.plan(self.task);
        self.findings = [];
        execs = [-->];
        if self.fanout < len(execs) {
            # a task-hash-chosen subset: OR branching the server has to predict
            h = zlib.crc32(f"{self.task}{self.round}".encode());
            execs = [e for (i, e) in enumerate(execs) if (i + h) % len(execs) < self.fanout];
        }
        visit execs;                        # one to many
    }
    can execute with Executor entry {
        self.findings.append(here.execute(self.plan));
        if len(self.findings) == self.fanout {     # the last executor closes the round
            self.round += 1;
            self.task = self.findings[0];   # feed forward: next round plans from a finding
            if self.round < self.rounds {
                visit [-->];                # back to the Planner
            }
        }
    }
}

with entry {
    rounds = int(os.environ.get("KVF_ROUNDS") or "3");
    task = os.environ.get("KVF_TASK") or "summarize the quarterly plan in one line";
    planner = Planner();
    execs = [Executor01(), Executor02(), Executor03(), Executor04(), Executor05(), Executor06(), Executor07()];
    fanout = min(len(execs), int(os.environ.get("KVF_FANOUT") or "7"));
    root ++> planner;
    for ex in execs {
        planner ++> ex;
        ex ++> planner;
    }
    FanOut(task=task, rounds=rounds, fanout=fanout) spawn planner;
}
